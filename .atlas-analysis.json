  "keyFeatures": [
    "Automatic cleanup via using/await using syntax",
    "Structured concurrency with parent-child cancellation",
    "Go-style channels and broadcast channels",
    "Circuit breakers, retries, and timeouts",
    "Distributed job scheduler with cron support",
    "Lazy async streams with 50+ operations",
    "Worker thread pool for CPU-intensive tasks",
    "Persistence adapters for Redis, PostgreSQL, MySQL, MongoDB, DynamoDB, SQLite",
    "Framework adapters for Fastify, Express, NestJS, Hono, Elysia, Koa, Hapi",
    "OpenTelemetry tracing and Prometheus metrics",
    "Resource pools and distributed locks",
    "Graceful shutdown handling"
  ],
